# ===== 模型（三选一，默认阿里云百炼 DashScope）=====
# 阿里云百炼：https://bailian.console.aliyun.com → API-KEY 管理 → 创建
# 新用户每个模型有免费额度；OpenAI 兼容端点见 config/models.json
DASHSCOPE_API_KEY=

# 备选：智谱 GLM-4-Flash（永久免费）https://open.bigmodel.cn
ZHIPU_API_KEY=

# 备选：DeepSeek https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 模型选择：provider 必须是 config/models.json 里定义过的
# dashscope 可选 qwen-flash（推荐：便宜且多轮工具调用稳定）/ qwen-plus（更强，但实测多轮里会漏调工具）
XIAOPAI_MODEL_PROVIDER=dashscope
XIAOPAI_MODEL_ID=qwen-flash

# ===== 服务 =====
XIAOPAI_PORT=8787
XIAOPAI_HOST=127.0.0.1

# ===== 调试开关 =====
# 1 = 精简工具集（隐藏 geocode_city / memory_forget），模型工具调用不稳时打开
XIAOPAI_MINIMAL_TOOLS=0
